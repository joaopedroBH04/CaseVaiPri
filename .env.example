# =====================================================================
# Apify (CAMINHO RECOMENDADO para dados reais completos)
# =====================================================================
# Token da Apify Platform — destrava DOIS bloqueios da Meta de uma vez:
#   1. Ad Library: pega anuncios reais com nomes corretos das paginas
#   2. Instagram: pega seguidores, engajamento REAL, bio, posts
#
# Como conseguir (gratuito, $5 de credito inicial = ~10 buscas):
#   1. apify.com/sign-up
#   2. Settings > Integrations > Personal API tokens
#   3. Cole abaixo (deve comecar com 'apify_api_')
APIFY_API_TOKEN=<COLE-SEU-TOKEN-APIFY-AQUI-OU-APAGUE-ESTA-LINHA>

# =====================================================================
# Meta Ad Library Graph API (alternativo, mais limitado)
# =====================================================================
# Token de acesso pra Meta Ad Library Graph API oficial. So usar se
# voce NAO tem Apify. Requer App Review da Meta pra producao real
# em ads_archive (processo de dias).
# Como conseguir: docs/COMO_ATIVAR_DADOS_REAIS.md
META_ACCESS_TOKEN=<COLE-SEU-TOKEN-META-AQUI-OU-APAGUE-ESTA-LINHA>

# =====================================================================
# Anthropic Claude API (OPCIONAL)
# =====================================================================
# Chave da API Anthropic. OPCIONAL — a ferramenta funciona sem.
# Em modo --demo, a chave nem e usada.
# Se quiser ativar o Claude pra qualidade extra no match, pegue uma em
# https://console.anthropic.com/ (NAO confundir com plano Claude Pro,
# que e produto diferente) e SUBSTITUA a linha abaixo.
ANTHROPIC_API_KEY=<COLE-SUA-CHAVE-AQUI-OU-APAGUE-ESTA-LINHA>

# Modelo Claude usado. O default abaixo equilibra custo e qualidade.
VAIPRI_CLAUDE_MODEL=claude-haiku-4-5-20251001

# Pais que filtra a Biblioteca de Anuncios. Default BR.
VAIPRI_COUNTRY=BR

# Numero maximo de candidatos a serem coletados da Ad Library
# antes do enriquecimento. Mais = mais qualidade, mais lento/caro.
VAIPRI_MAX_CANDIDATOS=40

# Quantos perfis ranqueados retornar no final.
VAIPRI_TOP_N=10

# Diretorio de cache em disco. TTL default = 24h.
VAIPRI_CACHE_DIR=.cache

# Headless Playwright. False ajuda no debug visual.
VAIPRI_HEADLESS=true

# Verbose logs no terminal.
VAIPRI_VERBOSE=false
